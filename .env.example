# Copy this file to .env.local and fill it in. Never commit .env.local.

# AI summary of the patient note (OpenRouter). Optional: without it the hospital sees the crew's note as written.
OPENROUTER_API_KEY=

# Shared storage in Supabase. Needed on a live site (Vercel) so every server sees the same trip and logins.
# Leave both empty to keep everything in server memory, which only works for one local machine.
# The secret key is for the server only. Never give it a NEXT_PUBLIC_ name.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Test mode: pre-fills logins and opens the planner with a ready trip. Do NOT set this on a real site.
# NEXT_PUBLIC_TEST_MODE=on